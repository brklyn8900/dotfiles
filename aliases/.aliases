#!/usr/bin/env zsh
# =============================================================================
# PORTABLE ALIASES - Works on any Mac/Linux
# =============================================================================
# Machine-specific aliases go in ~/.aliases.local (not tracked in git)

# -----------------------------------------------------------------------------
# Claude Code
# -----------------------------------------------------------------------------
alias y='claude --dangerously-skip-permissions'
alias yolo='claude --dangerously-skip-permissions'

# -----------------------------------------------------------------------------
# Editors
# -----------------------------------------------------------------------------
alias v='nvim'
alias n='nvim .'
alias e='zed .'
alias c='code .'
alias C='code-insiders .'
alias ws='windsurf .'
alias cr='cursor .'

# -----------------------------------------------------------------------------
# Navigation & Shell
# -----------------------------------------------------------------------------
alias a='nvim ~/.aliases'
alias al='nvim ~/.aliases.local'
alias rel='source ~/.zshrc'
alias j='..'
alias clr='clear'
alias k='clear'
alias cls='clear'
alias s='sudo'

# -----------------------------------------------------------------------------
# eza / ls (modern replacements)
# -----------------------------------------------------------------------------
alias l='eza -la --icons=always --sort=accessed --reverse --time=accessed --time-style=relative --group-directories-last'
alias ls='eza -la --icons=always'
alias ez='eza --git -lh'
alias la='ls -AF'
alias ll='ls -al'
alias l1='ls -1'
alias sl='ls'
alias i='ls -alt'

# -----------------------------------------------------------------------------
# Git
# -----------------------------------------------------------------------------
alias gs='git status'
alias gss='git status --short'
alias gu='git add -u'
alias gi='git commit -m "initial commit"'
alias gm='git checkout main'
alias dff='git diff main --stat'

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
alias py='python3'

# -----------------------------------------------------------------------------
# Zellij Layouts
# -----------------------------------------------------------------------------
alias zd='zellij --layout ~/.config/zellij/claude_layout.kdl'
alias zr='zellij --layout ~/.config/zellij/rails_layout.kdl'
alias zs='zellij --layout ~/.config/zellij/claude_simple.kdl'

# -----------------------------------------------------------------------------
# Starship Presets
# -----------------------------------------------------------------------------
alias cp='starship preset catppuccin-powerline -o ~/.config/starship.toml'
alias sb='starship preset nerd-font-symbols -o ~/.config/starship.toml'

# -----------------------------------------------------------------------------
# Homebrew
# -----------------------------------------------------------------------------
alias bup='brew update && brew upgrade'
alias bout='brew outdated'
alias bin='brew install'
alias brm='brew uninstall'
alias bls='brew list'
alias bsr='brew search'
alias binf='brew info'
alias bdr='brew doctor'

# -----------------------------------------------------------------------------
# Rails
# -----------------------------------------------------------------------------
alias dbm='rails db:migrate'
alias rs='touch tmp/restart.txt'
alias bd='bin/dev'
alias bw='bundle install --without production'
alias rgrep='ps aux | grep -i "rails.*server\|puma" | grep -v grep | head -5'

# -----------------------------------------------------------------------------
# macOS Specific
# -----------------------------------------------------------------------------
if [[ "$OSTYPE" == "darwin"* ]]; then
  # Desktop apps
  alias f='open -a Finder'
  alias fh='open -a Finder .'
  alias m='open -a "Marked 2"'
  alias xcode="open -a '/Applications/XCode.app'"
  alias safari='open -a safari'
  alias chrome='open -a google\ chrome'
  alias textedit='open -a TextEdit'
  alias hex='open -a "Hex Fiend"'
  alias slack="open -a '/Applications/Slack.app'"

  # Finder settings
  alias hidedesktop="defaults write com.apple.finder CreateDesktop -bool false && killall Finder"
  alias showdesktop="defaults write com.apple.finder CreateDesktop -bool true && killall Finder"
  alias showall='defaults write com.apple.finder AppleShowAllFiles YES && killall Finder'
  alias hideall='defaults write com.apple.finder AppleShowAllFiles NO && killall Finder'

  # System utilities
  alias dsclean='find . -type f -name .DS_Store -print0 | xargs -0 rm'
  alias flush='dscacheutil -flushcache'

  # Kitty themes
  alias ktheme='/Applications/kitty.app/Contents/MacOS/kitten themes'
fi

# -----------------------------------------------------------------------------
# Utility Aliases
# -----------------------------------------------------------------------------
alias pkg='cat package.json'
alias g='export GPG_TTY=$(tty)'
alias khg='lsof -ti:3332 | xargs kill'

# -----------------------------------------------------------------------------
# Archive/Extract (alias for function below)
# -----------------------------------------------------------------------------
alias x='extract'
alias dl='download'

# =============================================================================
# FUNCTIONS
# =============================================================================

# Download file
download() {
  curl -O "$1"
}

# Fix SSH agent
fixSSH() {
  eval $(ssh-agent)
  ssh-add ~/.ssh/id_rsa
}

# Create GIF from video
gif() {
  ffmpeg -i $1 -vf scale=$2:-1:flags=lanczos -f gif - | gifsicle --optimize=3 --delay=3 > $3
}

# Extract archives
extract() {
  local remove_archive
  local success
  local file_name
  local extract_dir

  if (( $# == 0 )); then
    echo "Usage: extract [-option] [file ...]"
    echo
    echo Options:
    echo "    -r, --remove    Remove archive."
    return 1
  fi

  remove_archive=1
  if [[ "$1" == "-r" ]] || [[ "$1" == "--remove" ]]; then
    remove_archive=0
    shift
  fi

  while (( $# > 0 )); do
    if [[ ! -f "$1" ]]; then
      echo "extract: '$1' is not a valid file" 1>&2
      shift
      continue
    fi

    success=0
    file_name="$( basename "$1" )"
    extract_dir="$( echo "$file_name" | sed "s/\.${1##*.}//g" )"
    case "$1" in
      (*.tar.gz|*.tgz) [ -z $commands[pigz] ] && tar zxvf "$1" || pigz -dc "$1" | tar xv ;;
      (*.tar.bz2|*.tbz|*.tbz2) tar xvjf "$1" ;;
      (*.tar.xz|*.txz) tar --xz --help &> /dev/null \
        && tar --xz -xvf "$1" \
        || xzcat "$1" | tar xvf - ;;
      (*.tar.zma|*.tlz) tar --lzma --help &> /dev/null \
        && tar --lzma -xvf "$1" \
        || lzcat "$1" | tar xvf - ;;
      (*.tar) tar xvf "$1" ;;
      (*.gz) [ -z $commands[pigz] ] && gunzip "$1" || pigz -d "$1" ;;
      (*.bz2) bunzip2 "$1" ;;
      (*.xz) unxz "$1" ;;
      (*.lzma) unlzma "$1" ;;
      (*.Z) uncompress "$1" ;;
      (*.zip|*.war|*.jar|*.sublime-package) unzip "$1" -d $extract_dir ;;
      (*.rar) unrar x -ad "$1" ;;
      (*.7z) 7za x "$1" ;;
      (*.deb)
        mkdir -p "$extract_dir/control"
        mkdir -p "$extract_dir/data"
        cd "$extract_dir"; ar vx "../${1}" > /dev/null
        cd control; tar xzvf ../control.tar.gz
        cd ../data; tar xzvf ../data.tar.gz
        cd ..; rm *.tar.gz debian-binary
        cd ..
        ;;
      (*)
        echo "extract: '$1' cannot be extracted" 1>&2
        success=1
        ;;
    esac

    (( success = $success > 0 ? $success : $? ))
    (( $success == 0 )) && (( $remove_archive == 0 )) && rm "$1"
    shift
  done
}

# Compress file or folder
compress() {
  dirPriorToExe=`pwd`
  dirName=`dirname $1`
  baseName=`basename $1`

  if [ -f $1 ] ; then
    echo "It was a file change directory to $dirName"
    cd $dirName
    case $2 in
      tar.bz2) tar cjf $baseName.tar.bz2 $baseName ;;
      tar.gz) tar czf $baseName.tar.gz $baseName ;;
      gz) gzip $baseName ;;
      tar) tar -cvvf $baseName.tar $baseName ;;
      zip) zip -r $baseName.zip $baseName ;;
      *) echo "Method not passed compressing using tar.bz2"; tar cjf $baseName.tar.bz2 $baseName ;;
    esac
    echo "Back to Directory $dirPriorToExe"
    cd $dirPriorToExe
  else
    if [ -d $1 ] ; then
      echo "It was a Directory change directory to $dirName"
      cd $dirName
      case $2 in
        tar.bz2) tar cjf $baseName.tar.bz2 $baseName ;;
        tar.gz) tar czf $baseName.tar.gz $baseName ;;
        gz) gzip -r $baseName ;;
        tar) tar -cvvf $baseName.tar $baseName ;;
        zip) zip -r $baseName.zip $baseName ;;
        *) echo "Method not passed compressing using tar.bz2"; tar cjf $baseName.tar.bz2 $baseName ;;
      esac
      echo "Back to Directory $dirPriorToExe"
      cd $dirPriorToExe
    else
      echo "'$1' is not a valid file/folder"
    fi
  fi
  echo "Done"
  echo "###########################################"
}

# =============================================================================
# LOCAL ALIASES (machine-specific, not in git)
# =============================================================================
[[ -f ~/.aliases.local ]] && source ~/.aliases.local
